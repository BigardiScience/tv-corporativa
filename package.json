{
  "name": "tv-corporativa",
  "version": "2.4.0",
  "private": true,
  "description": "TV corporativa: biblioteca de mídias em pastas, playlists, programações e player, com administração por unidade e setor.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "configure": "node --env-file-if-exists=.env scripts/configure.mjs",
    "reset-admin": "node --env-file-if-exists=.env scripts/reset-admin.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "audit:verify": "node --env-file-if-exists=.env scripts/verify-audit.mjs",
    "check": "node scripts/check.mjs"
  }
}
