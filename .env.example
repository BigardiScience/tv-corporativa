# Copie para .env. Nunca versione o arquivo .env (ele já está no .gitignore e no .dockerignore).
# Segredos (SETUP_TOKEN, TEST_ADMIN_PASSWORD) ficam SEMPRE vazios neste exemplo.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
DATA_DIR=./data

# Banco, mídias e backups ficam dentro de DATA_DIR. Só defina estes três para colocá-los em outro disco/pasta
# (por exemplo, um disco persistente do servidor). Caminhos relativos partem da pasta do projeto.
# DB_PATH=./data/tvcorp.sqlite
# MEDIA_DIR=./data/media
# BACKUP_DIR=./data/backups

# Para cadastro inicial no navegador, defina um token aleatório com >= 32 caracteres.
# Alternativa recomendada local: npm run configure (assistente no terminal).
SETUP_TOKEN=

# Produção: NODE_ENV=production, APP_ORIGIN=https://tv.suaempresa.com.br
# TLS deve terminar no proxy reverso; o backend deve ficar em rede privada.
# Produção exige scanner compatível com clamscan e base de assinaturas atualizada.
MALWARE_SCANNER=
# O scanner recebe: --no-summary --infected <arquivo>
MAX_UPLOAD_MB=50

# Quantidade máxima de itens por playlist (1 a 15). Playlists antigas maiores que o limite continuam funcionando.
PLAYLIST_MAX_ITEMS=6

# Quantos proxies reversos confiáveis existem na frente do servidor (0 a 5; false = nenhum, true = 1).
# Só mude se o IP do cliente chegar no cabeçalho X-Forwarded-For escrito pelo SEU proxy (Render: 1).
TRUST_PROXY=false

# Somente HOMOLOGAÇÃO (ex.: Render com disco efêmero): se NODE_ENV=development e ainda não existe administrador,
# o servidor cria um a partir destas três variáveis. São ignoradas em qualquer outro NODE_ENV.
# Defina no painel da hospedagem, nunca neste arquivo versionado.
# TEST_ADMIN_NAME=
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
